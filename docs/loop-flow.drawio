        <mxCell id="e19" value="スライスごとの指示文&lt;br&gt;（範囲 / 触ってよいディレクトリ / 読む SKILL.md / 完了条件）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;fontSize=10;fontColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n7">
