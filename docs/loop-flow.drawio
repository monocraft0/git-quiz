        <mxCell id="e23" value="ADRのBlockerは&lt;br&gt;差し戻さず本体が書く" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#9673a6;fontSize=10;fontColor=#9673a6;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n22">
          <mxGeometry relative="1" as="geometry">
