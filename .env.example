# infra (docker compose) — 通常は `make start` が .env を自動生成する。
# 手動で用意するなら: cp .env.example .env
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# このテンプレートから作ったアプリは PostgreSQL のコンテナとボリュームを共有する。
# 分離されるのはデータベース単位なので、POSTGRES_DB は必ずアプリごとに変えること。
# 共有すると別アプリの Flyway 履歴と衝突して起動できなくなる。
# `make start` が .env 初回生成時にディレクトリ名を書き込む。
POSTGRES_DB=app
