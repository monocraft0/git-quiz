        <mxCell id="e13" value="FAIL（ADR以外）→ Blocker の&lt;br&gt;原文を担当へ差し戻し（最大3回）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n7">
